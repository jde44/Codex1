[Unit]
Description=RSK AI
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rsk-ai
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=-/opt/rsk-ai/.env.production
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=10
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
