[Unit]
Description=ARGBriX
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/argbrix
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=-/opt/argbrix/.env.production
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=10
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
